{
  "name": "be-flashy",
  "version": "0.0.3",
  "description": "Set css class temporarily when element state changes",
  "homepage": "https://github.com/bahrus/be-flashy#readme",
  "bugs": {
    "url": "https://github.com/bahrus/be-flashy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/be-flashy.git"
  },
  "license": "MIT",
  "author": "anderson.bruce.b@gmail.com",
  "type": "module",
  "main": "be-flashy.js",
  "module": "be-flashy.js",
  "exports": {
    ".": "./be-flashy.js",
    "./be-flashy.js": "./be-flashy.js",
    "./emc.js": "./emc.mjs",
    "./🚨.js": "./🚨.mjs"
  },
  "files": [
    "*.js",
    "*.mjs",
    "*.json",
    "./types/be-flashy/types.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "node emc.mjs > emc.json && node 🚨.mjs > 🚨.json",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "dependencies": {
    "be-hive": "0.1.15",
    "mount-observer": "0.1.41",
    "roundabout-lib": "0.0.23",
    "nested-regex-groups": "0.0.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "spa-ssi": "0.0.27"
  }
}
